<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🤖" android:textSize="60sp" android:layout_marginTop="20dp" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="My AI" android:textColor="#3BE0FF" android:textSize="30sp"
            android:textStyle="bold" android:letterSpacing="0.1" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Choose how you want to use your AI" android:textColor="#7C8AB0"
            android:textSize="15sp" android:gravity="center" android:layout_marginBottom="30dp" />

        <Button android:id="@+id/pickStudent"
            android:layout_width="match_parent" android:layout_height="72dp"
            android:text="🎓  STUDENT" android:textSize="17sp" android:textStyle="bold"
            android:background="@drawable/chip_off" android:textColor="#E6EEFF"
            android:layout_marginBottom="14dp" />
        <Button android:id="@+id/pickBusiness"
            android:layout_width="match_parent" android:layout_height="72dp"
            android:text="💼  BUSINESS" android:textSize="17sp" android:textStyle="bold"
            android:background="@drawable/chip_off" android:textColor="#E6EEFF"
            android:layout_marginBottom="14dp" />
        <Button android:id="@+id/pickDaily"
            android:layout_width="match_parent" android:layout_height="72dp"
            android:text="🌟  DAILY USE" android:textSize="17sp" android:textStyle="bold"
            android:background="@drawable/chip_off" android:textColor="#E6EEFF"
            android:layout_marginBottom="30dp" />

        <TextView android:id="@+id/creatorLink"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔒 Creator login" android:textColor="#56627F" android:textSize="13sp"
            android:padding="10dp" />

    </LinearLayout>
</ScrollView>
