<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F1A">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="💼 Business AI" android:textColor="#3BE0FF" android:textSize="20sp"
            android:textStyle="bold" android:letterSpacing="0.05" />
        <Button android:id="@+id/muteBtn" android:layout_width="44dp" android:layout_height="44dp"
            android:text="🔊" android:background="@drawable/chip_off" />
        <Button android:id="@+id/bubbleBtn" android:layout_width="wrap_content" android:layout_height="44dp"
            android:text="💬 Float" android:textSize="12sp" android:textColor="#3BE0FF"
            android:background="@drawable/chip_off" android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Business toolkit -->
    <HorizontalScrollView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingBottom="6dp">
        <LinearLayout android:id="@+id/toolkit"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Messages -->
    <ScrollView android:id="@+id/scroll"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:padding="8dp">
        <LinearLayout android:id="@+id/messages"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Input -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="10dp" android:gravity="center_vertical">
        <EditText android:id="@+id/input"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="Message, or 'draw a cat'…" android:textColor="#E6EEFF" android:textColorHint="#56627F"
            android:backgroundTint="#3BE0FF" android:maxLines="4" android:inputType="textCapSentences|textMultiLine" />
        <Button android:id="@+id/micBtn" android:layout_width="48dp" android:layout_height="48dp"
            android:text="🎤" android:background="@drawable/chip_off" android:layout_marginStart="6dp" />
        <Button android:id="@+id/sendBtn" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="➤" android:textSize="18sp" android:background="@drawable/btn_send"
            android:textColor="#0A0E1A" android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
