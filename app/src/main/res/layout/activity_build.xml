<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F1A">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/backBuildBtn"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:text="← Back" android:background="@drawable/chip_off" android:textColor="#3BE0FF" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="🛠️ Live Preview" android:textColor="#3BE0FF" android:textSize="17sp"
            android:textStyle="bold" android:gravity="center" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/shareBuildBtn"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:text="⤴ Share" android:background="@drawable/btn_send" android:textColor="#06121F" />
    </LinearLayout>

    <WebView android:id="@+id/buildWeb"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="#FFFFFF" />
</LinearLayout>
